<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AI BIT</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ai_bit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Both keys are required, and reasoning about what the app *does* is not
	     enough. Shipping only the add-only key failed upload with:

	       90683: Missing purpose string in Info.plist ... should contain a
	       NSPhotoLibraryUsageDescription key ...

	     Apple scans the linked binary, not the code paths taken: the `gal`
	     library references read APIs, so the read string is demanded even
	     though nothing here ever reads the library. Their own note says
	     "While your app might not use these APIs, a purpose string is still
	     required." -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AI BIT saves videos you download into your Photos library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AI BIT needs photo library access to save downloaded videos. It never reads or uploads your photos.</string>
	<!-- The same rule caught us a second time, with FFmpeg. It is linked for
	     joining HD video and audio downloads, and it references AVFoundation's
	     capture APIs — so the scanner demands camera and microphone strings even
	     though no screen in this app opens either. Both are declared honestly
	     rather than invented: the app has no camera or recording feature, and
	     saying otherwise in a string users can read would be a lie.

	     The microphone key is here pre-emptively. Only the camera one was
	     rejected, but the same binary references both, and finding out costs
	     another upload and another build number. -->
	<key>NSCameraUsageDescription</key>
	<string>AI BIT does not use the camera. This declaration is required because the media library that joins downloaded video and audio links Apple's capture APIs.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AI BIT does not record audio. This declaration is required because the media library that joins downloaded video and audio links Apple's capture APIs.</string>
	<!-- Answers App Store Connect's export-compliance question at build time.
	     Without it every uploaded build stops at "Missing Compliance" and waits
	     for someone to click through the web form before testers can install
	     it. The app only uses HTTPS, which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required for background audio playback and Picture-in-Picture.
	     Without "audio" here iOS suspends AVPlayer the moment the app leaves
	     the foreground, and AVPictureInPictureController refuses to start. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- YouTube media is served from googlevideo.com CDN hosts over https, but
	     some HLS fragment hosts still negotiate down. Allow those to load. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
