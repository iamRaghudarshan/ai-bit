<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+ (dataExtractionRules); same intent as
     backup_rules.xml, which covers Android 11 and below. The downloaded
     videos are excluded from device-to-device transfer too: they can be many
     gigabytes, and re-downloading beats a transfer that stalls or fails. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
